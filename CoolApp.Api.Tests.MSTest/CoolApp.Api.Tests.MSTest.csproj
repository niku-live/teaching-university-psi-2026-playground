<Project Sdk="Microsoft.NET.Sdk">

  <!-- The same tests as CoolApp.Api.Tests.XUnit, written with MSTest instead of xUnit, for comparison.
       Not part of CoolApp.sln, so a plain `dotnet test` skips it. To run it, see the README. -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- MSTest's runner for Microsoft.Testing.Platform (selected in global.json) makes the
         test project an executable, like xUnit v3 -->
    <OutputType>Exe</OutputType>
    <EnableMSTestRunner>true</EnableMSTestRunner>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\CoolApp.Api\CoolApp.Api.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.14" />
    <PackageReference Include="MSTest" Version="4.5.1" />
    <PackageReference Include="NSubstitute" Version="6.2.0" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Microsoft.VisualStudio.TestTools.UnitTesting" />
  </ItemGroup>

</Project>
