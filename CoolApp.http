@HostAddress = https://localhost:7039

### Get all study sessions
GET {{HostAddress}}/api/studysessions
Accept: application/json

### Get a single study session by id
GET {{HostAddress}}/api/studysessions/1
Accept: application/json

### Get a study session that does not exist (expect 404 Not Found)
GET {{HostAddress}}/api/studysessions/999
Accept: application/json

### Get lightweight session summaries (the immutable StudySessionSummary record - no id, no host)
GET {{HostAddress}}/api/studysessions/summary
Accept: application/json

### Create a new study session
# startsAt carries an explicit "Z" (UTC) offset, same as the browser form now sends -
# a bare "2026-09-23T18:00:00" would be interpreted as *this server's* local time.
POST {{HostAddress}}/api/studysessions
Content-Type: application/json

{
  "course": "Software Development I",
  "topic": "Testing your own API",
  "location": "MIF, room 401",
  "startsAt": "2026-09-23T18:00:00Z",
  "hostName": "You",
  "seatsAvailable": 4
}

### Create a session that's already full (seatsAvailable: 0 is valid - watch its "status")
POST {{HostAddress}}/api/studysessions
Content-Type: application/json

{
  "course": "Software Development I",
  "topic": "Small informal recap, no more room",
  "location": "MIF, room 401",
  "startsAt": "2026-09-23T18:00:00Z",
  "hostName": "You",
  "seatsAvailable": 0
}

### Update a study session
PUT {{HostAddress}}/api/studysessions/1
Content-Type: application/json

{
  "course": "Software Development I",
  "topic": "Pull request etiquette",
  "location": "MIF, room 401",
  "startsAt": "2026-09-24T18:00:00Z",
  "hostName": "Ieva",
  "seatsAvailable": 1
}

### Delete a study session
DELETE {{HostAddress}}/api/studysessions/2

### Create a study session with invalid data (expect 400 Bad Request)
POST {{HostAddress}}/api/studysessions
Content-Type: application/json

{
  "course": "",
  "topic": "Testing validation",
  "location": "MIF, room 401",
  "startsAt": "2020-01-01T18:00:00Z",
  "hostName": "You",
  "seatsAvailable": -1
}

### Rate a session (watch "hostRating" appear on the next GET)
PUT {{HostAddress}}/api/studysessions/1/rating
Content-Type: application/json

{
  "value": 4
}

### Rate a session with an invalid value (expect 400 Bad Request)
PUT {{HostAddress}}/api/studysessions/1/rating
Content-Type: application/json

{
  "value": 7
}

### Filter sessions by course (partial, case-insensitive match)
GET {{HostAddress}}/api/studysessions?course=software
Accept: application/json

### Filter sessions by minimum seats available
GET {{HostAddress}}/api/studysessions?minSeatsAvailable=4
Accept: application/json

### Preview what's upcoming as of a future moment (asOf), instead of right now
GET {{HostAddress}}/api/studysessions?asOf=2026-10-15T00:00:00Z
Accept: application/json

### Summaries filtered by minimum seats available only - there's no course filter here on purpose
GET {{HostAddress}}/api/studysessions/summary?minSeatsAvailable=4
Accept: application/json
